#!/bin/sh
# Resolve the wickra-impact C ABI (header + shared library) for the Unix build.
#
# Until this existed the package built only where something had already set
# WKIMPACT_INC and WKIMPACT_LIB -- which is to say, only in this repository's CI. A user
# running install.packages() got a compiler error about a missing header.
#
# Self-contained by default: download the prebuilt wickra-impact-c-<triple>.tar.gz
# release asset matching this package's version and stage the shared library into
# src/, so the compiled object links against it and bundles it (via
# install.libs.R), found post-install through an rpath ($ORIGIN on Linux,
# @loader_path on macOS). Set WKIMPACT_INC + WKIMPACT_LIB to build against a locally
# built C ABI instead (the dev override; e.g. `cargo build -p wickra-impact-c
# --release`). Download and extraction use base R, which is always present at
# build time, so there is no curl/wget system dependency.
set -e

inc=""
lib=""

# A freshly-cut GitHub release can briefly return 404 while its assets propagate
# across the CDN, and a transient network blip should not fail the build either.
# Retry base R's download.file with a backoff (~2 min total) rather than giving
# up on the first miss.
fetch_release_archive() {
  _url="$1"
  _dest="$2"
  _attempt=1
  while [ "${_attempt}" -le 6 ]; do
    if "${R_HOME}/bin/Rscript" -e "download.file('${_url}', '${_dest}', mode = 'wb', quiet = TRUE)"; then
      return 0
    fi
    echo "wickra-impact: download attempt ${_attempt}/6 failed (${_url}); the release asset may still be propagating -- retrying in 20s..."
    sleep 20
    _attempt=$((_attempt + 1))
  done
  echo "wickra-impact: failed to download ${_url} after 6 attempts"
  return 1
}

# WebAssembly (r-universe's webR target) is not supported and says so rather
# than failing further in with a link error. The scan core itself compiles to
# wasm -- the wasm binding proves it, with default features off -- but no
# emscripten C ABI archive is published for this configure to fetch, and
# building one from source here would compile a toolchain path nothing tests.
# The browser build is shipped as the wasm npm package instead.
if [ "$(uname -s)" = "Emscripten" ]; then
  echo "wickra-impact: no WebAssembly build -- no emscripten C ABI archive is published."
  echo "wickra-impact: the browser build is published separately as the wickra-impact-wasm npm package."
  exit 1
fi

if [ -n "${WKIMPACT_INC}" ] && [ -n "${WKIMPACT_LIB}" ]; then
  echo "wickra-impact: using the C ABI from WKIMPACT_INC / WKIMPACT_LIB (dev override)"
  inc="${WKIMPACT_INC}"
  lib="${WKIMPACT_LIB}"
else
  version=$(sed -n 's/^Version:[[:space:]]*//p' DESCRIPTION)
  os=$(uname -s)
  arch=$(uname -m)
  case "${os}" in
    Linux)
      case "${arch}" in
        x86_64) triple="x86_64-unknown-linux-gnu" ;;
        aarch64 | arm64) triple="aarch64-unknown-linux-gnu" ;;
        *) echo "wickra-impact: unsupported Linux arch '${arch}' -- set WKIMPACT_INC/WKIMPACT_LIB"; exit 1 ;;
      esac
      ;;
    Darwin)
      case "${arch}" in
        x86_64) triple="x86_64-apple-darwin" ;;
        arm64 | aarch64) triple="aarch64-apple-darwin" ;;
        *) echo "wickra-impact: unsupported macOS arch '${arch}' -- set WKIMPACT_INC/WKIMPACT_LIB"; exit 1 ;;
      esac
      ;;
    *)
      echo "wickra-impact: unsupported OS '${os}' -- set WKIMPACT_INC/WKIMPACT_LIB"
      exit 1
      ;;
  esac
  url="https://github.com/wickra-lib/wickra-impact/releases/download/v${version}/wickra-impact-c-${triple}.tar.gz"
  echo "wickra-impact: downloading the C ABI ${triple} for v${version}"
  fetch_release_archive "${url}" "src/wickra-impact-c.tar.gz" || exit 1
  "${R_HOME}/bin/Rscript" -e "untar('src/wickra-impact-c.tar.gz', exdir = 'src/wickra-impact-c')"
  inc="src/wickra-impact-c/wickra-impact-c-${triple}/include"
  lib="src/wickra-impact-c/wickra-impact-c-${triple}/lib"
fi

# Stage the header and the platform shared library into src/ so the package
# object links with -L. -lwickra_impact and install.libs.R bundles the lib.
cp "${inc}/wickra_impact.h" src/wickra_impact.h
staged=""
for f in libwickra_impact.so libwickra_impact.dylib; do
  if [ -f "${lib}/${f}" ]; then
    cp "${lib}/${f}" "src/${f}"
    staged="${f}"
  fi
done
if [ -z "${staged}" ]; then
  echo "wickra-impact: no libwickra_impact.so/.dylib found under ${lib}"
  exit 1
fi

# rpath so the bundled library is found next to the package object after install.
case "$(uname -s)" in
  Darwin)
    rpath="-Wl,-rpath,@loader_path"
    # Normalise the dylib id to @rpath so @loader_path resolution applies.
    install_name_tool -id "@rpath/${staged}" "src/${staged}" 2>/dev/null || true
    ;;
  *)
    rpath="-Wl,-rpath,'\$\$ORIGIN'"
    ;;
esac

sed "s|@WKIMPACT_RPATH@|${rpath}|" src/Makevars.in > src/Makevars
echo "wickra-impact: configured (bundled ${staged})"
exit 0
