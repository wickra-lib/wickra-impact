<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wickra.Impact.Examples</RootNamespace>
  </PropertyGroup>

  <!-- The binding from this checkout, not the NuGet package: the example must
       build before the package exists, and must exercise the code next to it. -->
  <ItemGroup>
    <ProjectReference Include="../../../bindings/csharp/WickraImpact/WickraImpact.csproj" />
  </ItemGroup>

</Project>
